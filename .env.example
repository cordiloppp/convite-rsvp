# Copia este archivo a .env antes de levantar la demo: cp .env.example .env

# Base de datos
POSTGRES_USER=convite
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=convite

# JWT: mínimo 32 caracteres. Usa un valor largo y aleatorio.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRE_MINUTES=480

# Marca
BRAND_NAME=Convite
BRAND_URL=https://convite.example.com

# URL con la que los invitados abren su link.
# Con localhost el link no abre desde otro teléfono: para probar en celular
# usa tu IP local (http://192.168.x.x:5173) o un túnel.
PUBLIC_APP_URL=http://localhost:5173

# Zona horaria en la que se capturan y muestran las fechas de los eventos
APP_TIMEZONE=America/Tijuana

# Carga los datos de ejemplo al arrancar, solo si el planner demo aún no existe
SEED_DEMO=true
